{
  "name": "@ngp/photo-sync",
  "version": "0.1.0",
  "private": true,
  "description": "PhotoSync: the native backup engine of Not Google Photos, as a Capacitor plugin (Android now, iOS later).",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "author": "Not Google Photos",
  "license": "MIT",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "backup"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "docgen": "mkdir -p dist && docgen --api PhotoSyncPlugin --output-json dist/docs.json",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test:android": "cd android && ./gradlew testDebugUnitTest",
    "build:android-tests": "cd android && ./gradlew assembleDebugAndroidTest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/docgen": "^0.3.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
