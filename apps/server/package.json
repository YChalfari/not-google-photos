{
  "name": "@ngp/server",
  "version": "0.1.0",
  "private": true,
  "description": "API server, job workers, and database migrations.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-dev-dirs.mjs && tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "seed": "node scripts/ensure-dev-dirs.mjs && tsx src/cli/seed.ts",
    "openapi": "tsx src/cli/openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@ngp/shared": "workspace:*",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
