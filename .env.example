# Copy to .env. `pnpm dev` and infra/compose.sh both read it.
# Real environment variables win over this file.

# Postgres published on 54320 so it does not collide with another local server.
POSTGRES_USER=ngp
POSTGRES_PASSWORD=ngp
POSTGRES_DB=ngp
POSTGRES_PORT=54320
DATABASE_URL=postgres://ngp:ngp@localhost:54320/ngp

# Library folder. Leave unset for <repo>/data/library.
# On a Mac with an external drive, set an absolute path such as:
# LIBRARY_DIR=/Volumes/Photos/NotGooglePhotos
# The server will not create a missing drive folder, and it refuses uploads if the
# marker file in this folder disappears.

PORT=4810
# Phones on your Wi-Fi. Use the Mac's LAN address, not localhost.
# HOME_URL=http://192.168.1.20:4810
# Optional away-from-home HTTPS address. See the README.
# REMOTE_URL=https://photos.example.com
# ML_URL=http://127.0.0.1:8090
# SERVER_NAME=Home Photos
# TRUST_PROXY=false
# LOG_LEVEL=info
